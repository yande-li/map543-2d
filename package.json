{
  "name": "map543-2d",
  "version": "0.1.0",
  "description": "Lightweight 2D viewport and map rendering engine powered by 32-bit TypedArrays and WebAssembly.",
  "license": "BSD-3-Clause",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./kernels.wasm": "./dist/wasm/kernels.wasm"
  },
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "npm run build:wasm && tsc -p tsconfig.build.json && node -e \"const fs=require('fs');fs.mkdirSync('dist/wasm',{recursive:true});fs.copyFileSync('wasm/kernels.wasm','dist/wasm/kernels.wasm');\"",
    "prepare": "npm run build",
    "test": "vitest run",
    "bench": "RUN_BENCH=1 vitest run __tests__/map543.bench.test.ts"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wabt": "^1.0.39"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
