{
  "name": "map543-2d",
  "version": "0.4.0",
  "description": "Reduced-precision 2D map rendering library for lower memory usage.",
  "license": "ISC",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./cruise": {
      "types": "./dist/cruise.d.ts",
      "import": "./dist/cruise.js"
    },
    "./cruise/react": {
      "types": "./dist/cruise-react.d.ts",
      "import": "./dist/cruise-react.js"
    },
    "./kernels.wasm": "./dist/kernels.wasm"
  },
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs && wasm-validate wasm/kernels.wasm",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run build:wasm && tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts/build-bundle.mjs",
    "size": "node scripts/check-size.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "bench": "RUN_BENCH=1 vitest run __tests__/map543.bench.test.ts",
    "changelog": "node scripts/changelog.mjs"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.2.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rolldown": "^1.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "wabt": "^1.0.39"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
